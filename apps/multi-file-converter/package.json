{
  "name": "multi-file-converter",
  "version": "1.0.0",
  "description": "Client-side multi file converter (documents, images, audio, video, archives). No backend, deployable to GitHub Pages.",
  "private": true,
  "type": "module",
  "scripts": {
    "vendor": "node scripts/vendor.mjs",
    "serve": "node scripts/serve.mjs",
    "test": "node tests/e2e.mjs && python3 -I tests/verify.py",
    "vendor:strict": "node scripts/vendor.mjs --strict"
  },
  "dependencies": {
    "@ffmpeg/core": "0.12.10",
    "@ffmpeg/ffmpeg": "0.12.15",
    "@pdf-lib/fontkit": "1.1.1",
    "@tesseract.js-data/eng": "1.0.0",
    "@tesseract.js-data/ind": "1.0.0",
    "docx": "9.8.1",
    "heic2any": "0.0.4",
    "jszip": "3.10.1",
    "pako": "2.1.0",
    "pdf-lib": "1.17.1",
    "pdfjs-dist": "6.2.108",
    "pptxgenjs": "4.0.1",
    "tesseract.js": "5.1.1",
    "tesseract.js-core": "5.1.1",
    "utif": "3.1.0"
  },
  "devDependencies": {
    "playwright": "*"
  }
}
